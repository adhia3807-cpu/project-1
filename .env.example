# GROQ_API_KEY: Required for Groq AI language model inference (backend-only).
# Configure this in your environment or Render environment variables.
GROQ_API_KEY="your_groq_api_key_here"

# GROQ_MODEL: Configurable Groq model (defaults to llama-3.3-70b-versatile).
GROQ_MODEL="llama-3.3-70b-versatile"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
